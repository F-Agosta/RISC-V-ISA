+++ b/src/arch/riscv/decoder.cc
@@ -34,6 +34,8 @@
 #include "base/bitfield.hh"
 #include "debug/Decode.hh"
 
+uint32_t hdc_accumulators[32] = {0};
+
 namespace gem5
 {
 
diff --git a/src/arch/riscv/isa/decoder.isa b/src/arch/riscv/isa/decoder.isa
index 569da4b942..bdf9951761 100644
--- a/src/arch/riscv/isa/decoder.isa
+++ b/src/arch/riscv/isa/decoder.isa
@@ -6488,6 +6488,58 @@ decode QUADRANT default Unknown::unknown() {
             }
         }
 
+        // ---------------------------------------------------------------
+        // custom-2 opcode (0x5B): Stateful HDC Acceleration
+        // funct3 = 1: HD_BIND_ACCUM
+        // funct3 = 2: HD_THRESHOLD
+        // funct3 = 3: HD_TERNARY_DOT
+        // ---------------------------------------------------------------
+        0x16: decode FUNCT3 {
+            format ROp {
+                0x1: hd_bind_accum({{
+                    uint32_t bound = Rs1_uw ^ Rs2_uw;
+                    for (int i = 0; i < 32; ++i) {
+                        if ((bound >> i) & 1) {
+                            hdc_accumulators[i]++;
+                        }
+                    }
+                    Rd = 0;
+                }}, HdcAluOp);
+                
+                0x2: hd_threshold({{
+                    uint32_t threshold = Rs1_uw;
+                    uint32_t result = 0;
+                    for (int i = 0; i < 32; ++i) {
+                        if (hdc_accumulators[i] > threshold) {
+                            result |= (1U << i);
+                        }
+                        hdc_accumulators[i] = 0;
+                    }
+                    Rd = result;
+                }}, HdcAluOp);
+
+                0x3: hd_ternary_dot({{
+                    uint32_t q = Rs1_uw;
+                    uint32_t c = Rs2_uw;
+                    int32_t score = 0;
+                    for (int i = 0; i < 16; ++i) {
+                        uint8_t q_bit = (q >> i) & 1;
+                        uint8_t t_mag = (c >> (2 * i)) & 1;
+                        uint8_t t_sign = (c >> (2 * i + 1)) & 1;
+                        
+                        if (t_mag) {
+                            if (q_bit == !t_sign) {
+                                score += 1;
+                            } else {
+                                score -= 1;
+                            }
+                        }
+                    }
+                    Rd = (uint64_t)(int64_t)score;
+                }}, HdcAluOp);
+            }
+        }
+
         0x1e: M5Op::M5Op();
     }
 }
